# ─────────────────────────────────────────────────────────────
# ARQUIVO DE REFERÊNCIA
# Esse arquivo NÃO contém senhas reais — só mostra QUAIS variáveis
# o projeto vai precisar. As senhas reais vão direto no Render.
# ─────────────────────────────────────────────────────────────

# ── URL pública do site ──────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Banco de dados PostgreSQL ────────────────────────────────
# O Render vai te dar essa URL quando você criar o PostgreSQL
DATABASE_URL="postgresql://user:senha@host:5432/banco?schema=public"

# ── Sessão / autenticação ────────────────────────────────────
# String longa aleatória (mínimo 32 caracteres)
AUTH_SECRET="troque-por-uma-string-longa-e-aleatoria-min-32-chars"

# ── E-mail SMTP (verificação por código, recuperar senha) ────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seuemail@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="nao-responda@seudominio.com"
SMTP_FROM_NAME="Minha Loja Digital"

# ── Mercado Pago ─────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN="SEU_ACCESS_TOKEN_AQUI"
MERCADOPAGO_PUBLIC_KEY="SUA_PUBLIC_KEY_AQUI"
MERCADOPAGO_WEBHOOK_SECRET="SEU_WEBHOOK_SECRET_AQUI"

# ── Admin inicial (criado automaticamente no primeiro deploy) ─
ADMIN_EMAIL="admin@minhaloja.com"
ADMIN_PASSWORD="TroqueEstaSenha123!"
ADMIN_NAME="Administrador"
